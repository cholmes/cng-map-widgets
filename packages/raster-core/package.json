{
  "name": "@cngeo/raster-core",
  "version": "0.3.0",
  "description": "In-browser raster clip-and-download: windowed reads from remote COGs (geotiff.js over HTTP ranges), band subsetting from STAC band metadata, an exact pre-download size estimate with a memory ceiling, and a dependency-free GeoTIFF writer that preserves dtype and georeferencing.",
  "keywords": [
    "cog",
    "geotiff",
    "raster",
    "clip",
    "stac",
    "portolan",
    "range-requests",
    "cloud-native",
    "cng"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@cngeo/spec": "0.3.0"
  },
  "devDependencies": {
    "geotiff": "2.1.3",
    "zstddec": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cholmes/cng-map-widgets.git",
    "directory": "packages/raster-core"
  },
  "homepage": "https://github.com/cholmes/cng-map-widgets#readme",
  "bugs": {
    "url": "https://github.com/cholmes/cng-map-widgets/issues"
  }
}
