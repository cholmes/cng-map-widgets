{
  "name": "@cngeo/format-gpkg",
  "version": "0.4.0",
  "description": "GeoPackage output for @cngeo/extract-core: a hand-written SQLite 'vector features' profile (gpkg_contents/gpkg_spatial_ref_sys/gpkg_geometry_columns + the feature table), built with sql.js. The ~340KB (min+gz) path O5 chose over gdal3.js's 2-8MB wasm build -- see README.md and experiments/e10-heavy-formats/RESULTS.md.",
  "keywords": [
    "geopackage",
    "gpkg",
    "sqlite",
    "sql.js",
    "wasm",
    "download",
    "cng"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@cngeo/spec": "0.4.0"
  },
  "devDependencies": {
    "sql.js": "1.13.0",
    "@cngeo/extract-core": "0.4.0",
    "hyparquet": "1.33.0",
    "hyparquet-compressors": "1.1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cholmes/cng-map-widgets.git",
    "directory": "packages/format-gpkg"
  },
  "homepage": "https://github.com/cholmes/cng-map-widgets#readme",
  "bugs": {
    "url": "https://github.com/cholmes/cng-map-widgets/issues"
  }
}
