{
  "name": "@cngeo/maplibre",
  "version": "0.3.1",
  "description": "MapLibre GL adapter for the @cngeo widgets: an accessible search combobox control, an Area outline layer (with a dashed ghost of the filter geometry), a viewport provider for the ranking boost, and antimeridian-aware fitBounds.",
  "keywords": [
    "maplibre",
    "maplibre-gl",
    "geocoder",
    "control",
    "map-widget",
    "combobox",
    "cloud-native",
    "cng"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/index.js"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "maplibre-gl": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "@cngeo/spec": "0.3.1",
    "@cngeo/timeline": "0.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cholmes/cng-map-widgets.git",
    "directory": "packages/maplibre"
  },
  "homepage": "https://github.com/cholmes/cng-map-widgets#readme",
  "bugs": {
    "url": "https://github.com/cholmes/cng-map-widgets/issues"
  },
  "devDependencies": {
    "@deck.gl/core": "9.4.2",
    "@deck.gl/extensions": "9.4.2",
    "@deck.gl/geo-layers": "9.4.2",
    "@deck.gl/layers": "9.4.2",
    "@deck.gl/maplibre": "9.4.2",
    "@deck.gl/mesh-layers": "9.4.2",
    "@developmentseed/deck.gl-geotiff": "0.10.0",
    "@developmentseed/deck.gl-raster": "0.10.0",
    "@developmentseed/geotiff": "0.10.0",
    "@loaders.gl/mvt": "4.5.5",
    "@luma.gl/core": "9.4.2",
    "@luma.gl/engine": "9.4.2",
    "@luma.gl/shadertools": "9.4.2",
    "@luma.gl/webgl": "9.4.2",
    "maplibre-gl": "5.24.1",
    "proj4": "2.22.0"
  }
}
