{
  "name": "@cngeo/timeline",
  "version": "0.4.0",
  "description": "A histogram timeline over time-chunked map data: chunk descriptors of any period, a chunk-set orchestrator, playback, and a canvas timeline component. No map library.",
  "keywords": [
    "timeline",
    "time-slider",
    "temporal",
    "pmtiles",
    "histogram",
    "playback",
    "cloud-native",
    "cng"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@cngeo/spec": "0.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cholmes/cng-map-widgets.git",
    "directory": "packages/timeline"
  },
  "homepage": "https://github.com/cholmes/cng-map-widgets#readme",
  "bugs": {
    "url": "https://github.com/cholmes/cng-map-widgets/issues"
  }
}
