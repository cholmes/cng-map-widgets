{
  "name": "@cngeo/upload-core",
  "version": "0.3.1",
  "description": "Drag/drop, paste or file-pick a GeoJSON file and get back the same Area object @cngeo/geocoder-core emits -- the composability seam. Validates and repairs real-world GeoJSON (rings, winding, Z, out-of-range coordinates) and reports every repair. registerReader() is the seam for more formats.",
  "keywords": [
    "geojson",
    "upload",
    "drag-and-drop",
    "repair",
    "validate",
    "area-of-interest",
    "cloud-native",
    "cng"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@cngeo/spec": "0.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cholmes/cng-map-widgets.git",
    "directory": "packages/upload-core"
  },
  "homepage": "https://github.com/cholmes/cng-map-widgets#readme",
  "bugs": {
    "url": "https://github.com/cholmes/cng-map-widgets/issues"
  }
}
