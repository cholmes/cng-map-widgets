{
  "name": "@cngeo/geocoder-core",
  "version": "0.4.0",
  "description": "Framework-agnostic place-name search over a published cloud-native gazetteer: manifest + index load (full or HTTP-range), name normalization, prefix search, a nine-component ranking total order with result diversity, and geometry resolution into an Area. No DOM, no map library.",
  "keywords": [
    "geocoder",
    "gazetteer",
    "autocomplete",
    "typeahead",
    "place-search",
    "geoparquet",
    "parquet",
    "hyparquet",
    "cloud-native",
    "geoboundaries",
    "overture",
    "cng"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@cngeo/spec": "0.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cholmes/cng-map-widgets.git",
    "directory": "packages/geocoder-core"
  },
  "homepage": "https://github.com/cholmes/cng-map-widgets#readme",
  "bugs": {
    "url": "https://github.com/cholmes/cng-map-widgets/issues"
  }
}
