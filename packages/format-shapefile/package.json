{
  "name": "@cngeo/format-shapefile",
  "version": "0.3.1",
  "description": "Shapefile output for @cngeo/extract-core: a zero-dependency, zero-wasm .shp/.shx/.dbf/.prj/.cpg writer bundled into one .shp.zip, with Shapefile's real limits (10-char field names, one shape type per file, ~2GiB size) surfaced as warnings instead of silent mangling.",
  "keywords": [
    "shapefile",
    "shp",
    "dbf",
    "download",
    "cng"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@cngeo/spec": "0.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cholmes/cng-map-widgets.git",
    "directory": "packages/format-shapefile"
  },
  "homepage": "https://github.com/cholmes/cng-map-widgets#readme",
  "bugs": {
    "url": "https://github.com/cholmes/cng-map-widgets/issues"
  }
}
