{
  "name": "@cngeo/openlayers",
  "version": "0.4.0",
  "description": "OpenLayers adapter for the @cngeo widgets: an accessible search combobox control, an Area outline layer, a viewport provider, antimeridian-aware fit, and the EPSG:4326 <-> view-projection bridge OpenLayers needs that MapLibre's GeoJSON-native sources do not.",
  "keywords": [
    "openlayers",
    "ol",
    "geocoder",
    "control",
    "map-widget",
    "projection",
    "epsg-3857",
    "cloud-native",
    "cng"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "ol": "^10.0.0"
  },
  "dependencies": {
    "@cngeo/spec": "0.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cholmes/cng-map-widgets.git",
    "directory": "packages/openlayers"
  },
  "homepage": "https://github.com/cholmes/cng-map-widgets#readme",
  "bugs": {
    "url": "https://github.com/cholmes/cng-map-widgets/issues"
  }
}
