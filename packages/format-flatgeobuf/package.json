{
  "name": "@cngeo/format-flatgeobuf",
  "version": "0.4.0",
  "description": "FlatGeobuf output for @cngeo/extract-core, wrapping the official flatgeobuf package's GeoJSON serializer. Measured ~10KB (min+gz) for the geojson submodule this plugin actually loads -- lighter than the design doc's original ~25KB estimate.",
  "keywords": [
    "flatgeobuf",
    "fgb",
    "download",
    "cng"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@cngeo/spec": "0.4.0"
  },
  "devDependencies": {
    "flatgeobuf": "4.6.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cholmes/cng-map-widgets.git",
    "directory": "packages/format-flatgeobuf"
  },
  "homepage": "https://github.com/cholmes/cng-map-widgets#readme",
  "bugs": {
    "url": "https://github.com/cholmes/cng-map-widgets/issues"
  }
}
