{
  "name": "@cngeo/spec",
  "version": "0.3.0",
  "description": "Shared contracts for cloud-native map widgets: the Area object, DatasetDescriptor/FilterSpec/DownloadRequest shapes, the CngError taxonomy, and pure geo helpers (bbox + antimeridian split, Visvalingam simplify, WKB decode, name normalization). No I/O, no dependencies.",
  "keywords": [
    "geospatial",
    "geojson",
    "bbox",
    "antimeridian",
    "simplify",
    "visvalingam",
    "wkb",
    "cloud-native",
    "gazetteer",
    "cng"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cholmes/cng-map-widgets.git",
    "directory": "packages/spec"
  },
  "homepage": "https://github.com/cholmes/cng-map-widgets#readme",
  "bugs": {
    "url": "https://github.com/cholmes/cng-map-widgets/issues"
  }
}
